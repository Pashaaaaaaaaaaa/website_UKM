{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true, "jsx": "preserve",
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true, "skipLibCheck": true,
    "declaration": true, "sourceMap": true, "outDir": "dist", "types": ["node"], "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts", "eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
