{
  "name": "ukm-organization-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular monolith foundation for organization news and rental services",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web,admin -c blue,green,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:api": "npm --workspace @ukm/api run dev",
    "dev:web": "npm --workspace @ukm/web run dev",
    "dev:admin": "npm --workspace @ukm/admin run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "test:watch": "node --test --watch tests/*.test.ts",
    "db:migrate": "node packages/database/src/migrate.ts",
    "db:seed": "node packages/database/src/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "bookings:expire": "node packages/api/src/expire-bookings.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/parser": "^8.43.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2"
  }
}
