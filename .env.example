# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose this value in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Optional public contact configuration. Use international digits for WhatsApp, e.g. 62812...
PUBLIC_MANAGER_WHATSAPP=
# JSON object containing public social URLs, e.g. {"instagram":"https://instagram.com/example"}
PUBLIC_SOCIAL_LINKS={}
BOOKING_ALLOW_PAST_DATES=false
BOOKING_MAX_RENTAL_DAYS=366
BOOKING_EXPIRY_INTERVAL_MS=60000
BOOKING_EXPIRY_BATCH_SIZE=500
WEB_PORT=3000
ADMIN_PORT=3001
NODE_ENV=development
